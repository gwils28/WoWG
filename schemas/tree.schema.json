{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "domain": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string",
          "pattern": "^[a-z0-9-]+:[a-z0-9-]+$"
        }
      },
      "required": [
        "id",
        "name",
        "icon"
      ]
    },
    "specialization": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string",
          "pattern": "^[a-z0-9-]+:[a-z0-9-]+$"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "icon"
      ]
    },
    "grid": {
      "type": "object",
      "properties": {
        "tiers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        }
      },
      "required": [
        "tiers",
        "columns"
      ]
    },
    "talents": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "icon": {
            "type": "string",
            "pattern": "^[a-z0-9-]+:[a-z0-9-]+$"
          },
          "tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "column": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "maxRank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "ranks": {
            "minItems": 1,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "prerequisites": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "talentId": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "rank": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "talentId"
              ]
            }
          },
          "ultimate": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "icon",
          "tier",
          "column",
          "maxRank",
          "ranks"
        ]
      }
    },
    "quests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "talents": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "steps": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "recurrence": {
            "type": "object",
            "properties": {
              "times": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "per": {
                "type": "string",
                "enum": [
                  "day",
                  "week",
                  "month"
                ]
              },
              "periods": {
                "type": "integer",
                "minimum": 1,
                "maximum": 52
              }
            },
            "required": [
              "times",
              "per",
              "periods"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "talents"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "domain",
    "specialization",
    "grid",
    "talents"
  ]
}
